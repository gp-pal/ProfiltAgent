# Root .env — STACK settings, read by docker compose and the Makefile.
# Copy to .env. Application settings and secrets (LLM keys, API key, registry DB,
# admin user) do not belong here: they go in orchestrator/.env.

# Project slug: compose project, container names (<slug>-nginx, <slug>-runner, …)
# and image names (<slug>-orchestrator, <slug>-runner). Lowercase, no spaces.
COMPOSE_PROJECT_NAME=profiltagent

# Display name shown in the admin panel, page titles and CLI output.
APP_NAME=ProfiltAgent

# Host port for the browser runner's localhost-only debug/health endpoint.
RUNNER_HOST_PORT=8080

# Shared secret between the orchestrator and the browser runner (Bearer token).
# Lives here because both containers need it. Generate: openssl rand -hex 32
# Empty = the runner accepts unauthenticated calls (local dev only).
RUNNER_TOKEN=
