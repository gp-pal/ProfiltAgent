# Laravel
/orchestrator/vendor/
/orchestrator/node_modules/
/orchestrator/public/hot
/orchestrator/public/storage
# Filament published assets — regenerated by `composer install` (filament:upgrade) / `php artisan filament:assets`
/orchestrator/public/css/filament
/orchestrator/public/js/filament
/orchestrator/public/fonts
/orchestrator/storage/*.key
# Laravel's runtime directories (storage/logs, storage/framework/*, bootstrap/cache,
# storage/app/private/runs) are tracked EMPTY: each holds its own .gitignore that ignores
# everything else. They must exist in a fresh clone, or `composer install` fails and
# Docker creates them root-owned.
/orchestrator/.env
/orchestrator/.env.backup
/orchestrator/.env.production
/orchestrator/.phpunit.result.cache
/orchestrator/Homestead.json
/orchestrator/Homestead.yaml
/orchestrator/auth.json
/orchestrator/npm-debug.log
/orchestrator/yarn-error.log
/orchestrator/.DS_Store
/orchestrator/Thumbs.db

# Agent Runs and Output
/orchestrator/runs/
/orchestrator/storage/app/runs/
/orchestrator/public/app/storage/
/runs
*.log
*.jsonl

