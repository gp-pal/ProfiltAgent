# orchestrator/.env — APPLICATION settings and secrets (Laravel).
# Stack-level values (project name, ports, RUNNER_TOKEN) live in the root .env.
# Under docker compose, APP_NAME, APP_ENV, APP_DEBUG, RUNNER_BASE, RUNNER_TOKEN,
# SEARXNG_URL and RUNS_DIR are set by docker-compose.yml and override this file.

# --- Application -----------------------------------------------------------------
APP_NAME="ProfiltAgent"
# Generate with: php artisan key:generate
APP_KEY=
# Keep false anywhere reachable; set true only for local debugging
APP_DEBUG=false
APP_URL=http://localhost
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Storage: SQLite database, sessions, cache and queue -------------------------
# The database file is orchestrator/database/database.sqlite (`make setup` creates it; then migrate).
DB_CONNECTION=sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Endpoint authentication -----------------------------------------------------
# Protects /api/run and /ws/* (send as X-Api-Key). REQUIRED for any networked
# deployment; empty = authentication disabled (local dev only).
# Generate with: openssl rand -hex 32
AGENT_API_KEY=

# --- Admin dashboard (/admin) ----------------------------------------------------
# Set these, then run: php artisan agent:create-admin
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- LLM ---------------------------------------------------------------------------
# Transport: prism (multi-provider) | legacy_ollama (original Guzzle client)
LLM_DRIVER=prism
# Provider for the prism driver: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
# LLM_TIMEOUT=120

# Claude: real sk-ant-... key, LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ChatGPT: real sk-... key, LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# Local Ollama: LLM_PROVIDER=ollama
# OLLAMA_URL=http://ollama:11434
# Legacy OpenAI-compatible transport (only LLM_DRIVER=legacy_ollama)
# OPENAI_API_BASE=http://ollama:11434/v1
# NUM_CTX=8192

# --- Browser runner ----------------------------------------------------------------
# Outside docker: http://localhost:8080 (or the root .env's RUNNER_HOST_PORT).
RUNNER_BASE=http://browser_runner:8080
# Outside docker only — under compose the token comes from the root .env.
# RUNNER_TOKEN=
# BROWSER_RUNNER_TIMEOUT=120

# DSL policy limits
MAX_STEPS=30
# Comma-separated hosts the DSL may visit; empty = no restriction.
ALLOWED_DOMAINS=
RUNS_DIR=runs

# --- Search (self-hosted SearXNG) --------------------------------------------------
# In docker: http://searxng:8080. For host-based `php artisan serve`: http://localhost:8888.
SEARXNG_URL=http://searxng:8080
# Global ceiling on SearXNG queries per minute across all processes. The engines it
# proxies rate-limit and CAPTCHA us; once suspended they return nothing for minutes,
# so our own burst is what empties a run. 0 disables the throttle.
SEARXNG_MAX_PER_MINUTE=20

# --- Collector ---------------------------------------------------------------------
# ReAct domain search (LLM-driven tool loop)
REACT_SEARCH_ENABLED=true
REACT_MAX_STEPS=8
# REACT_MATCH_JUDGE_ENABLED=true

# Wall-clock ceiling for the whole collector source ladder. The coverage score no
# longer stops a run — the declared field list does — so this is what prevents every
# run from touching every source. A run cut short here reports `partial`, never
# `data_limited`.
REACT_LADDER_BUDGET_S=120

# Open-web source: pages about the target outside its own site.
# REACT_OPEN_WEB_ENABLED=true
# REACT_OPEN_WEB_MAX_PAGES=4
# The target's own page on a business directory, used only when its text contains
# the target's registry code. Comma-separated; empty disables.
# URL templates with {code} that open or redirect to the company page:
REACT_OPEN_WEB_DIRECTORY_URLS=https://imoniurekvizitai.lt/paieska/?q={code}
# Hosts searched with `site:<host> <name>` (needs an engine that honours site:):
# REACT_OPEN_WEB_DIRECTORY_SITES=

# Contacts source: e-mails/phones from open pages that mention the target.
# REACT_CONTACTS_ENABLED=true
# REACT_CONTACTS_MAX_PAGES=4

# News dimension: portal-targeted search. The portal whitelist itself lives in the
# news_portals table and is edited at /admin/news-portals — not here.
# portals_per_query: how many domains share one `site:a OR site:b` query.
# max_people: caller-supplied directors/executives searched per run.
# max_queries: hard ceiling on searches per run.
# time_budget_s: wall-clock ceiling for the phase; 0 means "one query only".
# REACT_NEWS_ENABLED=true
REACT_NEWS_PORTALS_PER_QUERY=7
REACT_NEWS_MAX_PEOPLE=3
REACT_NEWS_MAX_QUERIES=4
REACT_NEWS_TIME_BUDGET_S=45
# Extract each kept article's text from the download the publish date already needed,
# via the runner's POST /markdown. Full text is stored under news/{slug}.md beside the
# captured .html; the profile carries only an excerpt.
REACT_NEWS_EXTRACT_TEXT=true
REACT_NEWS_EXTRACT_MAX=5
REACT_NEWS_EXCERPT_CHARS=600

# --- Company registry (optional) ---------------------------------------------------
# Read-only company-registry MariaDB. Schema: see CompanyRegistryRepository.
# Empty host = the registry source is skipped.
REGISTRY_DB_HOST=
REGISTRY_DB_PORT=3306
REGISTRY_DB_DATABASE=company_registry
REGISTRY_DB_USERNAME=
REGISTRY_DB_PASSWORD=
# Seconds any single registry query may take (connect + server-side statement).
# The DB is external and shared: without a cap, a loaded registry can block a run
# for minutes past the caller's timeout. Exceeding it skips the source instead.
REGISTRY_DB_TIMEOUT=5

# --- Langfuse LLM observability (optional) -----------------------------------------
# https://cloud.langfuse.com — tracing auto-disables when the keys are empty.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional; enables per-session Langfuse deep-links from the dashboard.
LANGFUSE_PROJECT_ID=
# Ingestion queue connection: 'sync' (inline, no worker) or 'database' (+ queue:work) to offload.
LANGFUSE_QUEUE_CONNECTION=sync
